# HTTP port the API (and the built web app) listens on.
PORT=3000

# Postgres connection string. Leave empty to use the embedded PGlite database
# stored in PGLITE_DATA_DIR (zero-setup local development).
DATABASE_URL=

# Where PGlite stores its files when DATABASE_URL is empty.
PGLITE_DATA_DIR=./.data/pglite

# Secret used to sign session tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Seed demo users (alice/bob/carol @ajaia.dev) on startup if they do not exist.
SEED_DEMO_DATA=true
